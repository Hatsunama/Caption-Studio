  "dependencies": {
    "@react-navigation/native": "^7.3.16",
    "caption-media": "file:modules/caption-media",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.13",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.13",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "whisper.rn": "^0.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "tsx": "4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "node ./scripts/patch-react-native-gradle.js",
    "start": "expo start",
    "android": "expo prebuild --platform android && node ./scripts/patch-react-native-gradle.js && expo run:android",
    "release:android": "set \"NODE_ENV=production\" && expo prebuild --platform android && node ./scripts/patch-react-native-gradle.js && cd android && gradlew.bat assembleRelease --no-daemon && cd .. && node ./scripts/sign-android-release.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:logic": "tsx --test tests/*.test.mjs"
  },
  "private": true
}
