{
  "expo": {
    "name": "Caption Studio",
    "slug": "caption-studio",
    "version": "1.4.100",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "captionstudio",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.xmilo_at_your_side.caption_studio",
      "versionCode": 112,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-sqlite",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "./plugins/with-splash-screen-api-contract",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 176
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Caption Studio to record voice-over narration.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-sharing",
      "./plugins/with-legacy-export-permission",
      "./plugins/with-soloader-metadata",
      "./plugins/with-litert-gpu-libraries",
      "expo-font",
      "expo-image",
      "./plugins/with-android-lint-contract"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
