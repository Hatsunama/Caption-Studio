<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.captionstudio.verification.sharereceiver"
    android:versionCode="1" android:versionName="1.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />
    <application android:label="Caption Studio Verification" android:debuggable="true"
        android:allowBackup="false" android:hasCode="true"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".VerificationActivity" android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/x-subrip" />
                <!-- Wildcard accommodates ExpoSharing when it supplies */*.
                     Acceptance still requires a granted content URI and bounded SRT validation. -->
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
